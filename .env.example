# Copy this file to ".env" (cp .env.example .env) and set your own password.
# ".env" is in .gitignore, so it never goes to GitHub.
DB_USERNAME=root
DB_PASSWORD=change-me-to-a-strong-password

# Probability that a payment is declined (0 = never, 1 = always, 0.2 = 20%). Great for demos.
PAYMENT_FAILURE_RATE=0.2
